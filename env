# -------------------------------
# Application Settings
# -------------------------------
NODE_ENV=production
PORT=5000

# -------------------------------
# MongoDB Configuration
# -------------------------------
MONGO_URI=mongodb://localhost:27017/myapp

# -------------------------------
# Redis Configuration
# -------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1

# Leave empty if no password set
REDIS_PASSWORD=

# -------------------------------
# JWT Configuration
# -------------------------------
# Use strong secrets in production (use `openssl rand -base64 64`)
JWT_ACCESS_SECRET=supersecret_access_key_123
JWT_REFRESH_SECRET=supersecret_refresh_key_456

# Token Expiry times
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -------------------------------
# Logging & Misc
# -------------------------------
LOG_LEVEL=info

# ---------------
# App Name

APP_NAME=file-ud-be